# XRPL
XRPL_WSS=wss://s.altnet.rippletest.net:51233
PORT=8787

# DeepSeek (agent brain)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# World ID (backend-only; NEVER put RP_SIGNING_KEY in frontend)
WORLDID_RP_SIGNING_KEY=0x...
WORLDID_RP_ID=rp_xxx
WORLDID_APP_ID=app_xxx
WORLDID_ACTION=meshcredit-agent-verify

# Frontend env vars (Vite exposes these via import.meta.env — safe to expose)
VITE_APP_ID=app_xxx
VITE_RP_ID=rp_xxx

# Zefix KYB (email zefix@bj.admin.ch to obtain)
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
ZEFIX_FIXTURE=true   # set false when real credentials are available

# AML sanctions snapshot
SANCTIONS_SNAPSHOT_PATH=data/sanctions_snapshot_20260621.csv
SANCTIONS_FIXTURE=false

# Thick-file agent (pre-seeded by scripts/seed-thick-agent.ts)
THICK_AGENT_ADDR=

# Settlement asset — leave issuer blank to settle in XRP (simplest demo).
# Set these after running `npm run setup:stablecoin` to use a self-issued
# test stablecoin (RLUSD stand-in) with trustline-locking enabled.
# STABLE_ISSUER=
# STABLE_CCY=USD
