{
  "name": "meshcredit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MeshCredit — portable on-chain agent credit identity on XRPL",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
