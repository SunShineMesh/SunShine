    "setup:stablecoin": "tsx src/xrpl/setupStablecoin.ts"
  },
  "dependencies": {
    "@worldcoin/idkit-core": "^4.1.8",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
